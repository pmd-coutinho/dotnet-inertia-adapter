<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WolverineFx 6 targets net9.0 and net10.0 only. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>InertiaNet.Wolverine</RootNamespace>
    <AssemblyName>InertiaNet.Wolverine</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet metadata -->
    <PackageId>InertiaNet.Wolverine</PackageId>
    <Version>$(InertiaNetPlatformPackageVersion)</Version>
    <Authors>Pedro Coutinho</Authors>
    <Description>Wolverine.HTTP integration for InertiaNet: serve Inertia.js pages from Wolverine.HTTP endpoints.</Description>
    <PackageTags>inertia;inertiajs;dotnet;aspnetcore;wolverine;wolverinefx;critterstack</PackageTags>
    <PackageProjectUrl>https://github.com/pmd-coutinho/dotnet-inertia-adapter</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pmd-coutinho/dotnet-inertia-adapter</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InertiaNet\InertiaNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.Http" Version="6.65.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
